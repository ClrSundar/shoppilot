generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id String @id @default(uuid())

  name String
  code String @unique

  businessType BusinessType @default(GENERAL)

  email String?
  phone String?

  active Boolean      @default(true)
  status TenantStatus @default(PENDING)

  rejectedReason      String?
  agentDiscountConfig Json?

  approvedById String?
  approvedAt   DateTime?

  users                      User[]
  categories                 ProductCategory[]
  products                   Product[]
  inventoryStocks            InventoryStock[]
  inventoryLedgerEntries     InventoryLedgerEntry[]
  customers                  Customer[]
  customerTypes              CustomerType[]
  suppliers                  Supplier[]
  agents                     Agent[]
  discountRules              DiscountRule[]
  quotes                     Quote[]
  priceOverrideApprovals     PriceOverrideApproval[]
  agentCommissionRules       AgentCommissionRule[]
  agentCommissionAccruals    AgentCommissionAccrual[]
  agentCommissionSettlements AgentCommissionSettlement[]
  purchaseOrders             PurchaseOrder[]
  payments                   Payment[]
  productReturns             ProductReturn[]
  whatsappConversations      WhatsAppConversation[]
  whatsappMessages           WhatsAppMessage[]
  copilotSessions            CopilotSession[]
  copilotMessages            CopilotMessage[]
  copilotDraftConfirmations  CopilotDraftConfirmation[]
  subscription               Subscription?
  featureOverrides           TenantFeatureOverride[]
  usageCounters              UsageCounter[]
  recommendationRuns         RecommendationRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CommissionType {
  PERCENTAGE
  FIXED_AMOUNT
  PER_UNIT
  SLAB
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FIXED_PRICE
}

enum DiscountScope {
  PRODUCT
  CATEGORY
  CUSTOMER
  CUSTOMER_TYPE
  QUOTE
  TENANT
}

enum ApprovalStatus {
  REQUESTED
  APPROVED
  REJECTED
}

enum CommissionBasis {
  GROSS_SALES
  NET_SALES
  GROSS_MARGIN
  PRODUCT_MARGIN
  PAYMENT_RECEIVED
}

enum CommissionStatus {
  PENDING
  EARNED
  APPROVED
  PARTIALLY_PAID
  PAID
  CANCELLED
  REVERSED
}

model PlatformAdmin {
  id String @id @default(uuid())

  name     String
  email    String @unique
  password String

  role PlatformAdminRole @default(SUPPORT_ADMIN)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Plan {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)

  billingCycle BillingCycle @default(MONTHLY)
  priceAmount  Decimal      @db.Decimal(10, 2)
  currency     String       @default("USD")
  trialDays    Int          @default(0)

  features      PlanFeature[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model FeatureFlag {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)

  planFeatures  PlanFeature[]
  overrides     TenantFeatureOverride[]
  usageCounters UsageCounter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlanFeature {
  id String @id @default(uuid())

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  featureFlagId String
  featureFlag   FeatureFlag @relation(fields: [featureFlagId], references: [id])

  enabled    Boolean @default(true)
  limitValue Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, featureFlagId])
  @@index([planId])
  @@index([featureFlagId])
}

model Subscription {
  id String @id @default(uuid())

  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  status            SubscriptionStatus @default(ACTIVE)
  startAt           DateTime
  endAt             DateTime?
  trialEndAt        DateTime?
  cancelAtPeriodEnd Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([planId])
  @@index([status])
}

model TenantFeatureOverride {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  featureFlagId String
  featureFlag   FeatureFlag @relation(fields: [featureFlagId], references: [id])

  enabled    Boolean
  limitValue Int?
  reason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, featureFlagId])
  @@index([tenantId])
  @@index([featureFlagId])
}

model UsageCounter {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  featureFlagId String
  featureFlag   FeatureFlag @relation(fields: [featureFlagId], references: [id])

  periodKey String
  usedCount Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, featureFlagId, periodKey])
  @@index([tenantId])
  @@index([periodKey])
}

model User {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name  String
  email String

  password String

  role UserRole

  active Boolean @default(true)

  copilotSessions           CopilotSession[]
  copilotMessages           CopilotMessage[]
  copilotDraftConfirmations CopilotDraftConfirmation[]
  recommendationRuns        RecommendationRun[]
  recommendationFeedbacks   RecommendationFeedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  SALES
  TECHNICIAN
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum PlatformAdminRole {
  SUPER_ADMIN
  SUPPORT_ADMIN
}

enum BusinessType {
  ELECTRICAL
  PLUMBING
  MOTOR
  GENERAL
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

model ProductCategory {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name        String
  description String?

  active Boolean @default(true)

  products        Product[]
  discountRules   DiscountRule[]
  commissionRules AgentCommissionRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Product {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  categoryId String
  category   ProductCategory @relation(fields: [categoryId], references: [id])

  name String

  sku String?

  brand String?

  description String?

  unit String @default("NOS")

  costPrice              Decimal  @db.Decimal(12, 2)
  landingPrice           Decimal? @db.Decimal(12, 2)
  minimumMarginPercent   Decimal? @db.Decimal(5, 2)
  allowBelowLandingPrice Boolean  @default(false)
  sellingPrice           Decimal  @db.Decimal(12, 2)

  gstRate Decimal? @db.Decimal(5, 2)

  barcode String?

  imageUrl String?

  metadata Json?

  active Boolean @default(true)

  quoteItems               QuoteItem[]
  purchaseOrderItems       PurchaseOrderItem[]
  productReturnItems       ProductReturnItem[]
  inventoryStocks          InventoryStock[]
  inventoryLedgerEntries   InventoryLedgerEntry[]
  attributeValues          ProductAttributeValue[]
  sourceCompatibilities    ProductCompatibility[]    @relation("sourceCompatibility")
  targetCompatibilities    ProductCompatibility[]    @relation("targetCompatibility")
  recommendationCandidates RecommendationCandidate[]
  discountRules            DiscountRule[]
  commissionRules          AgentCommissionRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([categoryId])
}

enum AttributeDataType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
}

model AttributeDefinition {
  id String @id @default(uuid())

  tenantId String?

  code String

  name String

  dataType AttributeDataType

  unit String?

  allowedValues Json?

  description String?

  appliesToCategoryId String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attributeValues ProductAttributeValue[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([code])
}

model ProductAttributeValue {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  attributeDefinitionId String
  attributeDefinition   AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Cascade)

  valueText String?

  valueNumber Decimal?

  valueBoolean Boolean?

  valueJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, attributeDefinitionId])
  @@index([productId])
  @@index([attributeDefinitionId])
}

model Customer {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name String

  phone          String?
  whatsappNumber String?
  email          String?

  address String?

  gstNumber String?

  customerTypeId String?
  customerType   CustomerType? @relation(fields: [customerTypeId], references: [id])

  active Boolean @default(true)

  quotes                Quote[]
  payments              Payment[]
  productReturns        ProductReturn[]
  whatsappConversations WhatsAppConversation[]
  whatsappMessages      WhatsAppMessage[]
  recommendationRuns    RecommendationRun[]
  discountRules         DiscountRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([name])
  @@index([customerTypeId])
}

model CustomerType {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  code String
  name String

  defaultDiscountPercentage Decimal  @default(0) @db.Decimal(5, 2)
  priceListId               String?
  creditDays                Int?
  creditLimit               Decimal? @db.Decimal(12, 2)

  active Boolean @default(true)

  customers     Customer[]
  discountRules DiscountRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Supplier {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name      String
  phone     String?
  email     String?
  address   String?
  gstNumber String?

  active Boolean @default(true)

  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([name])
}

model Agent {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name           String
  phone          String?
  whatsappNumber String?
  email          String?
  address        String?
  referenceCode  String?

  defaultCommissionType       CommissionType @default(PERCENTAGE)
  defaultCommissionPercentage Decimal        @default(0) @db.Decimal(5, 2)

  active Boolean @default(true)

  quotes                Quote[]
  commissionRules       AgentCommissionRule[]
  commissionAccruals    AgentCommissionAccrual[]
  commissionSettlements AgentCommissionSettlement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, referenceCode])
  @@index([tenantId])
  @@index([name])
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  INVOICED
  DISPATCHED
  REJECTED
  EXPIRED
  CANCELLED
}

enum InventoryMovementType {
  IN
  OUT
  ADJUST_IN
  ADJUST_OUT
  RESERVE
  RELEASE
  DISPATCH
}

enum InventoryReferenceType {
  MANUAL
  QUOTE
  ORDER
  RETURN
}

enum WhatsAppIntent {
  NONE
  ADD_CUSTOMER
  ADD_CATEGORY
  ADD_PRODUCT
  CREATE_QUOTE
}

enum WhatsAppMessageDirection {
  INBOUND
  OUTBOUND
}

enum CopilotMessageRole {
  USER
  ASSISTANT
}

model CopilotSession {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  sessionId String

  messages           CopilotMessage[]
  draftConfirmations CopilotDraftConfirmation[]
  recommendationRuns RecommendationRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId, sessionId])
  @@index([tenantId, userId, updatedAt])
}

model CopilotDraftConfirmation {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  sessionDbId String
  session     CopilotSession @relation(fields: [sessionDbId], references: [id], onDelete: Cascade)

  token        String @unique
  draftPayload Json

  expiresAt DateTime
  usedAt    DateTime?

  idempotencyKey String?

  quoteId String?
  quote   Quote?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId, idempotencyKey])
  @@index([tenantId, userId, expiresAt])
  @@index([sessionDbId, createdAt])
}

model CopilotMessage {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  sessionDbId String
  session     CopilotSession @relation(fields: [sessionDbId], references: [id], onDelete: Cascade)

  role     CopilotMessageRole
  text     String
  metadata Json?

  createdAt DateTime @default(now())

  @@index([tenantId, userId, createdAt])
  @@index([sessionDbId, createdAt])
}

model WhatsAppConversation {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  senderPhone String

  lastIntent WhatsAppIntent @default(NONE)

  state Json?

  lastMessage  String?
  lastResponse String?

  messages WhatsAppMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, senderPhone])
  @@index([tenantId, senderPhone])
  @@index([tenantId, updatedAt])
  @@index([tenantId, customerId])
}

model WhatsAppMessage {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  conversationId String
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  externalMessageId String?
  senderPhone       String
  messageBody       String
  direction         WhatsAppMessageDirection

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, senderPhone])
  @@index([conversationId])
  @@index([customerId])
}

model Quote {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  agentId String?
  agent   Agent?  @relation(fields: [agentId], references: [id])

  quoteNumber String

  status        QuoteStatus @default(DRAFT)
  stockReserved Boolean     @default(false)

  subtotal               Decimal       @db.Decimal(12, 2)
  subtotalBeforeDiscount Decimal       @default(0) @db.Decimal(12, 2)
  taxableAmount          Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount              Decimal       @db.Decimal(12, 2)
  totalAmount            Decimal       @db.Decimal(12, 2)
  validUntil             DateTime?
  invoicedAt             DateTime?
  discountAmount         Decimal       @default(0) @db.Decimal(12, 2)
  lineDiscountAmount     Decimal       @default(0) @db.Decimal(12, 2)
  orderDiscountType      DiscountType?
  orderDiscountValue     Decimal?      @db.Decimal(12, 2)
  orderDiscountAmount    Decimal       @default(0) @db.Decimal(12, 2)
  taxPercentage          Decimal       @default(0) @db.Decimal(5, 2)

  agentCommissionType       CommissionType @default(PERCENTAGE)
  agentCommissionPercentage Decimal        @default(0) @db.Decimal(5, 2)
  agentCommissionAmount     Decimal        @default(0) @db.Decimal(12, 2)

  notes               String?
  recommendationRunId String?
  recommendationRun   RecommendationRun? @relation(fields: [recommendationRunId], references: [id], onDelete: SetNull)
  metadata            Json?

  items                     QuoteItem[]
  payments                  Payment[]
  productReturns            ProductReturn[]
  copilotDraftConfirmations CopilotDraftConfirmation[]
  priceOverrideApprovals    PriceOverrideApproval[]
  agentCommissionAccruals   AgentCommissionAccrual[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, quoteNumber])
  @@index([tenantId])
  @@index([customerId])
  @@index([agentId])
  @@index([recommendationRunId])
}

model QuoteItem {
  id String @id @default(uuid())

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  productName String

  quantity Decimal @db.Decimal(10, 2)

  unitPrice          Decimal       @db.Decimal(12, 2)
  baseUnitPrice      Decimal       @default(0) @db.Decimal(12, 2)
  discountType       DiscountType?
  discountPercentage Decimal?      @db.Decimal(5, 2)
  discountAmount     Decimal       @default(0) @db.Decimal(12, 2)
  netUnitPrice       Decimal       @default(0) @db.Decimal(12, 2)

  lineTotal Decimal @db.Decimal(12, 2)

  appliedDiscountRuleId String?
  appliedDiscountRule   DiscountRule? @relation(fields: [appliedDiscountRuleId], references: [id], onDelete: SetNull)
  discountReason        String?
  discountApprovedById  String?

  createdAt DateTime @default(now())

  @@index([quoteId])
  @@index([appliedDiscountRuleId])
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  orderNumber String
  status      PurchaseOrderStatus @default(DRAFT)

  supplierName      String
  supplierPhone     String?
  supplierEmail     String?
  supplierGstNumber String?

  subtotal    Decimal @db.Decimal(12, 2)
  taxAmount   Decimal @db.Decimal(12, 2)
  totalAmount Decimal @db.Decimal(12, 2)

  expectedDate DateTime?
  receivedAt   DateTime?

  notes       String?
  createdById String?

  items          PurchaseOrderItem[]
  payments       Payment[]
  productReturns ProductReturn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderItem {
  id String @id @default(uuid())

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  productName      String
  quantity         Decimal @db.Decimal(10, 2)
  unitCost         Decimal @db.Decimal(12, 2)
  lineTotal        Decimal @db.Decimal(12, 2)
  receivedQuantity Decimal @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseOrderId])
  @@index([productId])
}

enum PaymentDirection {
  RECEIVED
  PAID
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CHEQUE
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

model Payment {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  quoteId String?
  quote   Quote?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  amount      Decimal          @db.Decimal(12, 2)
  direction   PaymentDirection
  method      PaymentMethod
  status      PaymentStatus    @default(COMPLETED)
  paymentDate DateTime         @default(now())

  referenceNumber String?
  note            String?
  createdById     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commissionAccruals AgentCommissionAccrual[]

  @@index([tenantId])
  @@index([quoteId])
  @@index([purchaseOrderId])
  @@index([customerId])
  @@index([status])
}

enum ProductReturnType {
  SALES_RETURN
  PURCHASE_RETURN
}

enum ProductReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}

model ProductReturn {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  returnNumber String
  type         ProductReturnType
  status       ProductReturnStatus @default(REQUESTED)

  quoteId String?
  quote   Quote?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  reason      String?
  notes       String?
  createdById String?
  processedAt DateTime?

  items ProductReturnItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commissionAccruals AgentCommissionAccrual[]

  @@unique([tenantId, returnNumber])
  @@index([tenantId])
  @@index([status])
  @@index([type])
}

model ProductReturnItem {
  id String @id @default(uuid())

  productReturnId String
  productReturn   ProductReturn @relation(fields: [productReturnId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  productName        String
  quantity           Decimal @db.Decimal(10, 2)
  unitPrice          Decimal @db.Decimal(12, 2)
  lineTotal          Decimal @db.Decimal(12, 2)
  restockToInventory Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productReturnId])
  @@index([productId])
}

model DiscountRule {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  code        String
  name        String
  description String?

  scope DiscountScope
  type  DiscountType

  percentage Decimal? @db.Decimal(5, 2)
  amount     Decimal? @db.Decimal(12, 2)
  fixedPrice Decimal? @db.Decimal(12, 2)

  productId      String?
  product        Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  categoryId     String?
  category       ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  customerId     String?
  customer       Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerTypeId String?
  customerType   CustomerType?    @relation(fields: [customerTypeId], references: [id], onDelete: SetNull)

  minQuantity       Decimal? @db.Decimal(12, 2)
  minOrderValue     Decimal? @db.Decimal(12, 2)
  maxDiscountAmount Decimal? @db.Decimal(12, 2)

  priority         Int     @default(100)
  stackable        Boolean @default(false)
  requiresApproval Boolean @default(false)

  active        Boolean   @default(true)
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  createdById  String?
  approvedById String?
  approvedAt   DateTime?

  quoteItems QuoteItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@index([productId])
  @@index([categoryId])
  @@index([customerId])
  @@index([customerTypeId])
}

model PriceOverrideApproval {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  quoteItemId String

  requestedPrice      Decimal @db.Decimal(12, 2)
  minimumAllowedPrice Decimal @db.Decimal(12, 2)

  reason String
  status ApprovalStatus @default(REQUESTED)

  requestedById String
  approvedById  String?
  approvedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId, quoteId])
  @@index([quoteItemId])
  @@index([status])
}

model AgentCommissionRule {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  agentId String?
  agent   Agent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)

  code String
  name String

  type  CommissionType
  basis CommissionBasis

  percentage    Decimal? @db.Decimal(5, 2)
  fixedAmount   Decimal? @db.Decimal(12, 2)
  perUnitAmount Decimal? @db.Decimal(12, 2)

  productId  String?
  product    Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  minSalesAmount Decimal? @db.Decimal(12, 2)
  maxSalesAmount Decimal? @db.Decimal(12, 2)

  priority      Int       @default(100)
  active        Boolean   @default(true)
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  accruals AgentCommissionAccrual[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@index([agentId])
  @@index([productId])
  @@index([categoryId])
}

model AgentCommissionAccrual {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id])

  quoteId String?
  quote   Quote?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  productReturnId String?
  productReturn   ProductReturn? @relation(fields: [productReturnId], references: [id], onDelete: SetNull)

  commissionRuleId String?
  commissionRule   AgentCommissionRule? @relation(fields: [commissionRuleId], references: [id], onDelete: SetNull)

  basisAmount      Decimal  @db.Decimal(12, 2)
  commissionRate   Decimal? @db.Decimal(5, 2)
  commissionAmount Decimal  @db.Decimal(12, 2)

  status CommissionStatus @default(PENDING)

  earnedAt   DateTime?
  approvedAt DateTime?
  paidAmount Decimal   @default(0) @db.Decimal(12, 2)

  calculationSnapshot Json
  note                String?

  reversalOfId String?
  reversalOf   AgentCommissionAccrual?  @relation("CommissionReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals    AgentCommissionAccrual[] @relation("CommissionReversal")

  settlementItems AgentCommissionSettlementItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, agentId])
  @@index([quoteId])
  @@index([paymentId])
  @@index([productReturnId])
  @@index([status])
  @@index([commissionRuleId])
  @@index([reversalOfId])
}

model AgentCommissionSettlement {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id])

  settlementNumber String
  periodFrom       DateTime
  periodTo         DateTime

  totalEarned Decimal @db.Decimal(12, 2)
  deductions  Decimal @default(0) @db.Decimal(12, 2)
  paidAmount  Decimal @db.Decimal(12, 2)

  paymentMode      PaymentMethod?
  paymentReference String?
  paidAt           DateTime?

  createdAt DateTime @default(now())

  items AgentCommissionSettlementItem[]

  @@unique([tenantId, settlementNumber])
  @@index([tenantId, agentId])
}

model AgentCommissionSettlementItem {
  id String @id @default(uuid())

  settlementId String
  settlement   AgentCommissionSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  accrualId String
  accrual   AgentCommissionAccrual @relation(fields: [accrualId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(12, 2)

  @@unique([settlementId, accrualId])
  @@index([accrualId])
}

model InventoryStock {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  onHand       Decimal @default(0) @db.Decimal(12, 2)
  reserved     Decimal @default(0) @db.Decimal(12, 2)
  reorderLevel Decimal @default(0) @db.Decimal(12, 2)

  active Boolean @default(true)

  ledgerEntries InventoryLedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, productId])
  @@index([tenantId])
  @@index([productId])
}

model InventoryLedgerEntry {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  stockId String
  stock   InventoryStock @relation(fields: [stockId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  movementType InventoryMovementType
  quantity     Decimal               @db.Decimal(12, 2)

  referenceType InventoryReferenceType @default(MANUAL)
  referenceId   String?

  note String?

  createdById String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([productId])
  @@index([stockId])
  @@index([tenantId, createdAt])
}

// ===== PHASE 3: COMPATIBILITY & SOLUTIONS =====

enum CompatibilityRelationType {
  REQUIRED_WITH
  RECOMMENDED_WITH
  ALTERNATIVE_TO
  INCOMPATIBLE_WITH
}

enum RequirementType {
  REQUIRED
  RECOMMENDED
  OPTIONAL
}

model ProductCompatibility {
  id              String                    @id @default(uuid())
  tenantId        String? // NULL = platform standard
  sourceProductId String
  targetProductId String
  relationType    CompatibilityRelationType
  reason          String?
  priority        Int                       @default(2) // 1=critical, 2=important, 3=nice-to-have
  active          Boolean                   @default(true)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  source Product @relation("sourceCompatibility", fields: [sourceProductId], references: [id], onDelete: Cascade)
  target Product @relation("targetCompatibility", fields: [targetProductId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sourceProductId, targetProductId, relationType])
  @@index([sourceProductId])
  @@index([targetProductId])
}

model SolutionTemplate {
  id          String   @id @default(uuid())
  tenantId    String? // NULL = platform standard
  code        String
  name        String
  categoryId  String?
  purpose     String?
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items SolutionTemplateItem[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model SolutionTemplateItem {
  id                 String          @id @default(uuid())
  solutionTemplateId String
  productCategoryId  String?
  productId          String?
  requirementType    RequirementType
  defaultQuantity    Decimal         @default(1) @db.Decimal(12, 2)
  reason             String?
  priority           Int             @default(2)
  createdAt          DateTime        @default(now())

  template SolutionTemplate @relation(fields: [solutionTemplateId], references: [id], onDelete: Cascade)

  @@index([solutionTemplateId])
  @@index([productId])
}

// ===== PHASE 4: DECISION AUDIT TRAIL =====

enum DecisionRuleStatus {
  DRAFT
  ACTIVE
  DEPRECATED
  ARCHIVED
}

enum RecommendationRunStatus {
  PENDING
  MATCHED
  NO_MATCH
  ERROR
}

enum RecommendationAction {
  ACCEPTED
  REJECTED
  PARTIALLY_ACCEPTED
  IGNORED
}

model DecisionRule {
  id       String  @id @default(uuid())
  tenantId String? // NULL = platform standard rule, value = shop-specific override

  code        String // e.g. "BOREWELL_3HP_SINGLE_PHASE"
  name        String
  description String?

  status  DecisionRuleStatus @default(DRAFT)
  version Int                @default(1)

  // Matching conditions (stored as JSON for flexibility)
  conditions Json // e.g. { "depth": { "min": 300, "max": 350 }, "phase": "SINGLE" }

  // What to recommend when matched
  solutionTemplateId String? // Points to a SolutionTemplate to expand
  overrideProducts   Json? // Optional product overrides on top of template

  priority Int     @default(10) // Lower = higher priority when multiple rules match
  active   Boolean @default(true)

  approvedById String? // Who approved this rule
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs RecommendationRun[]

  @@unique([tenantId, code, version])
  @@index([tenantId])
  @@index([status])
  @@index([active])
}

model RecommendationRun {
  id       String @id @default(uuid())
  tenantId String // Mandatory: every recommendation belongs to one shop
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Who triggered this recommendation
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  copilotSessionId String?
  copilotSession   CopilotSession? @relation(fields: [copilotSessionId], references: [id])

  // Which rule fired (null if no match)
  decisionRuleId String?
  decisionRule   DecisionRule? @relation(fields: [decisionRuleId], references: [id])

  status RecommendationRunStatus @default(PENDING)

  // The raw query inputs
  queryInputs Json // e.g. { "depth": 325, "phase": "SINGLE", "budget": 15000 }

  // Summary of result
  totalCandidates Int      @default(0)
  topScore        Decimal? @db.Decimal(5, 2)

  // For debugging failed runs
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidates RecommendationCandidate[]
  feedback   RecommendationFeedback?
  quotes     Quote[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([userId])
  @@index([customerId])
  @@index([copilotSessionId])
  @@index([decisionRuleId])
}

model RecommendationCandidate {
  id String @id @default(uuid())

  runId String
  run   RecommendationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  rank Int // 1 = top recommendation

  totalScore Decimal @db.Decimal(5, 2)

  // Deterministic score breakdown (stock + price + attributes + preference = total)
  scoreStock          Decimal @db.Decimal(5, 2)
  scorePriceMatch     Decimal @db.Decimal(5, 2)
  scoreAttributeMatch Decimal @db.Decimal(5, 2)
  scorePreference     Decimal @db.Decimal(5, 2)

  // Why this product was selected or deselected
  selectedReason String? // For debugging: why this rank was assigned

  createdAt DateTime @default(now())

  @@unique([runId, productId])
  @@index([runId])
  @@index([productId])
  @@index([runId, rank])
}

model RecommendationFeedback {
  id String @id @default(uuid())

  runId String            @unique
  run   RecommendationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  action RecommendationAction

  // Which products were accepted/rejected
  acceptedProductIds Json @default("[]")
  rejectedProductIds Json @default("[]")

  // Free-text from shop owner
  notes String?

  // Who gave feedback
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([runId])
  @@index([userId])
}
