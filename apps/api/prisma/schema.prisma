generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id           String        @id @default(uuid())

  name         String
  code         String        @unique

  businessType BusinessType  @default(GENERAL)

  email        String?
  phone        String?

  active       Boolean       @default(true)
  status       TenantStatus  @default(PENDING)

  rejectedReason String?

  approvedById   String?
  approvedAt     DateTime?

  users        User[]
  categories   ProductCategory[]
  products     Product[]
  inventoryStocks InventoryStock[]
  inventoryLedgerEntries InventoryLedgerEntry[]
  customers    Customer[]
  agents       Agent[]
  quotes       Quote[]
  whatsappConversations WhatsAppConversation[]
  whatsappMessages WhatsAppMessage[]
  copilotSessions CopilotSession[]
  copilotMessages CopilotMessage[]
  copilotDraftConfirmations CopilotDraftConfirmation[]
  subscription  Subscription?
  featureOverrides TenantFeatureOverride[]
  usageCounters UsageCounter[]
  recommendationRuns RecommendationRun[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum CommissionType {
  PERCENTAGE
}

model PlatformAdmin {
  id        String            @id @default(uuid())

  name      String
  email     String            @unique
  password  String

  role      PlatformAdminRole @default(SUPPORT_ADMIN)

  active    Boolean           @default(true)

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}
model Plan {
  id                String          @id @default(uuid())
  code              String          @unique
  name              String
  description       String?
  isActive          Boolean         @default(true)
  
  billingCycle      BillingCycle    @default(MONTHLY)
  priceAmount       Decimal         @db.Decimal(10,2)
  currency          String          @default("USD")
  trialDays         Int             @default(0)
  
  features          PlanFeature[]
  subscriptions     Subscription[]
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  
  @@index([isActive])
}

model FeatureFlag {
  id                String          @id @default(uuid())
  code              String          @unique
  name              String
  description       String?
  isActive          Boolean         @default(true)
  
  planFeatures      PlanFeature[]
  overrides         TenantFeatureOverride[]
  usageCounters     UsageCounter[]
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model PlanFeature {
  id                String          @id @default(uuid())
  
  planId            String
  plan              Plan            @relation(fields: [planId], references: [id])
  
  featureFlagId     String
  featureFlag       FeatureFlag     @relation(fields: [featureFlagId], references: [id])
  
  enabled           Boolean         @default(true)
  limitValue        Int?
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  
  @@unique([planId, featureFlagId])
  @@index([planId])
  @@index([featureFlagId])
}

model Subscription {
  id                String          @id @default(uuid())
  
  tenantId          String          @unique
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  
  planId            String
  plan              Plan            @relation(fields: [planId], references: [id])
  
  status            SubscriptionStatus @default(ACTIVE)
  startAt           DateTime
  endAt             DateTime?
  trialEndAt        DateTime?
  cancelAtPeriodEnd Boolean         @default(false)
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  
  @@index([tenantId])
  @@index([planId])
  @@index([status])
}

model TenantFeatureOverride {
  id                String          @id @default(uuid())
  
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  
  featureFlagId     String
  featureFlag       FeatureFlag     @relation(fields: [featureFlagId], references: [id])
  
  enabled           Boolean
  limitValue        Int?
  reason            String?
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  
  @@unique([tenantId, featureFlagId])
  @@index([tenantId])
  @@index([featureFlagId])
}

model UsageCounter {
  id                String          @id @default(uuid())
  
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  
  featureFlagId     String
  featureFlag       FeatureFlag     @relation(fields: [featureFlagId], references: [id])
  
  periodKey         String
  usedCount         Int             @default(0)
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  
  @@unique([tenantId, featureFlagId, periodKey])
  @@index([tenantId])
  @@index([periodKey])
}
model User {
  id        String   @id @default(uuid())

  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  name      String
  email     String

  password  String

  role      UserRole

  active    Boolean  @default(true)

  copilotSessions CopilotSession[]
  copilotMessages CopilotMessage[]
  copilotDraftConfirmations CopilotDraftConfirmation[]
  recommendationRuns RecommendationRun[]
  recommendationFeedbacks RecommendationFeedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@unique([tenantId, email])
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  SALES
  TECHNICIAN
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum PlatformAdminRole {
  SUPER_ADMIN
  SUPPORT_ADMIN
}

enum BusinessType {
  ELECTRICAL
  PLUMBING
  MOTOR
  GENERAL
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

model ProductCategory {
  id          String   @id @default(uuid())

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  name        String
  description String?

  active      Boolean  @default(true)

  products    Product[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@unique([tenantId, name])
}

model Product {
  id            String   @id @default(uuid())

  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])

  categoryId    String
  category      ProductCategory @relation(fields: [categoryId], references: [id])

  name          String

  sku           String?

  brand         String?

  description   String?

  unit          String   @default("NOS")

  costPrice     Decimal  @db.Decimal(12,2)
  sellingPrice  Decimal  @db.Decimal(12,2)

  gstRate       Decimal? @db.Decimal(5,2)

  barcode       String?

  imageUrl      String?

  metadata      Json?

  active        Boolean  @default(true)

  quoteItems    QuoteItem[]
  inventoryStocks InventoryStock[]
  inventoryLedgerEntries InventoryLedgerEntry[]
  attributeValues ProductAttributeValue[]
  sourceCompatibilities ProductCompatibility[] @relation("sourceCompatibility")
  targetCompatibilities ProductCompatibility[] @relation("targetCompatibility")
  recommendationCandidates RecommendationCandidate[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([categoryId])
}

enum AttributeDataType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
}

model AttributeDefinition {
  id                    String                @id @default(uuid())

  tenantId              String?

  code                  String

  name                  String

  dataType              AttributeDataType

  unit                  String?

  allowedValues         Json?

  description           String?

  appliesToCategoryId   String?

  active                Boolean               @default(true)

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  attributeValues       ProductAttributeValue[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([code])
}

model ProductAttributeValue {
  id                          String                @id @default(uuid())

  productId                   String
  product                     Product               @relation(fields: [productId], references: [id], onDelete: Cascade)

  attributeDefinitionId       String
  attributeDefinition         AttributeDefinition   @relation(fields: [attributeDefinitionId], references: [id], onDelete: Cascade)

  valueText                   String?

  valueNumber                 Decimal?

  valueBoolean                Boolean?

  valueJson                   Json?

  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt

  @@unique([productId, attributeDefinitionId])
  @@index([productId])
  @@index([attributeDefinitionId])
}

model Customer {
  id              String   @id @default(uuid())

  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  name            String

  phone           String?
  whatsappNumber  String?
  email           String?

  address         String?

  gstNumber       String?

  active          Boolean  @default(true)

  quotes          Quote[]
  whatsappConversations WhatsAppConversation[]
  whatsappMessages WhatsAppMessage[]
  recommendationRuns RecommendationRun[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([name])
}

model Agent {
  id                          String          @id @default(uuid())

  tenantId                    String
  tenant                      Tenant          @relation(fields: [tenantId], references: [id])

  name                        String
  phone                       String?
  whatsappNumber              String?
  email                       String?
  address                     String?
  referenceCode               String?

  defaultCommissionType       CommissionType  @default(PERCENTAGE)
  defaultCommissionPercentage Decimal         @default(0) @db.Decimal(5,2)

  active                      Boolean         @default(true)

  quotes                      Quote[]

  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt

  @@index([tenantId])
  @@index([name])
  @@unique([tenantId, referenceCode])
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  INVOICED
  DISPATCHED
  REJECTED
  EXPIRED
  CANCELLED
}

enum InventoryMovementType {
  IN
  OUT
  ADJUST_IN
  ADJUST_OUT
  RESERVE
  RELEASE
  DISPATCH
}

enum InventoryReferenceType {
  MANUAL
  QUOTE
  ORDER
  RETURN
}

enum WhatsAppIntent {
  NONE
  ADD_CUSTOMER
  ADD_CATEGORY
  ADD_PRODUCT
  CREATE_QUOTE
}

enum WhatsAppMessageDirection {
  INBOUND
  OUTBOUND
}

enum CopilotMessageRole {
  USER
  ASSISTANT
}

model CopilotSession {
  id            String           @id @default(uuid())

  tenantId      String
  tenant        Tenant           @relation(fields: [tenantId], references: [id])

  userId        String
  user          User             @relation(fields: [userId], references: [id])

  sessionId     String

  messages      CopilotMessage[]
  draftConfirmations CopilotDraftConfirmation[]
  recommendationRuns RecommendationRun[]

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([tenantId, userId, sessionId])
  @@index([tenantId, userId, updatedAt])
}

model CopilotDraftConfirmation {
  id            String           @id @default(uuid())

  tenantId      String
  tenant        Tenant           @relation(fields: [tenantId], references: [id])

  userId        String
  user          User             @relation(fields: [userId], references: [id])

  sessionDbId   String
  session       CopilotSession   @relation(fields: [sessionDbId], references: [id], onDelete: Cascade)

  token         String           @unique
  draftPayload  Json

  expiresAt     DateTime
  usedAt        DateTime?

  idempotencyKey String?

  quoteId       String?
  quote         Quote?           @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([tenantId, userId, expiresAt])
  @@index([sessionDbId, createdAt])
  @@unique([tenantId, userId, idempotencyKey])
}

model CopilotMessage {
  id            String           @id @default(uuid())

  tenantId      String
  tenant        Tenant           @relation(fields: [tenantId], references: [id])

  userId        String
  user          User             @relation(fields: [userId], references: [id])

  sessionDbId   String
  session       CopilotSession   @relation(fields: [sessionDbId], references: [id], onDelete: Cascade)

  role          CopilotMessageRole
  text          String
  metadata      Json?

  createdAt     DateTime         @default(now())

  @@index([tenantId, userId, createdAt])
  @@index([sessionDbId, createdAt])
}

model WhatsAppConversation {
  id            String          @id @default(uuid())

  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id])

  customerId    String?
  customer      Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)

  senderPhone   String

  lastIntent    WhatsAppIntent  @default(NONE)

  state         Json?

  lastMessage   String?
  lastResponse  String?

  messages      WhatsAppMessage[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([tenantId, senderPhone])
  @@index([tenantId, updatedAt])
  @@index([tenantId, customerId])
  @@unique([tenantId, senderPhone])
}

model WhatsAppMessage {
  id                String                   @id @default(uuid())

  tenantId          String
  tenant            Tenant                   @relation(fields: [tenantId], references: [id])

  conversationId    String
  conversation      WhatsAppConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  customerId        String?
  customer          Customer?                @relation(fields: [customerId], references: [id], onDelete: SetNull)

  externalMessageId String?
  senderPhone       String
  messageBody       String
  direction         WhatsAppMessageDirection

  createdAt         DateTime                 @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, senderPhone])
  @@index([conversationId])
  @@index([customerId])
}

model Quote {
  id            String       @id @default(uuid())

  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])

  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id])

  agentId       String?
  agent         Agent?       @relation(fields: [agentId], references: [id])

  quoteNumber   String

  status        QuoteStatus  @default(DRAFT)
  stockReserved Boolean      @default(false)

  subtotal        Decimal       @db.Decimal(12,2)
  taxAmount       Decimal       @db.Decimal(12,2)
  totalAmount     Decimal       @db.Decimal(12,2)
  validUntil      DateTime?
  discountAmount  Decimal       @default(0) @db.Decimal(12,2)
  taxPercentage   Decimal       @default(0) @db.Decimal(5,2)

  agentCommissionType        CommissionType @default(PERCENTAGE)
  agentCommissionPercentage  Decimal        @default(0) @db.Decimal(5,2)
  agentCommissionAmount      Decimal        @default(0) @db.Decimal(12,2)

  notes         String?

  items         QuoteItem[]
  copilotDraftConfirmations CopilotDraftConfirmation[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([tenantId])
  @@index([customerId])
  @@index([agentId])

  @@unique([tenantId, quoteNumber])
}

model QuoteItem {
  id            String      @id @default(uuid())

  quoteId       String
  quote         Quote       @relation(fields: [quoteId], references: [id])

  productId     String
  product       Product     @relation(fields: [productId], references: [id])

  productName   String

  quantity      Decimal     @db.Decimal(10,2)

  unitPrice     Decimal     @db.Decimal(12,2)

  lineTotal     Decimal     @db.Decimal(12,2)

  createdAt     DateTime    @default(now())

  @@index([quoteId])
}

model InventoryStock {
  id            String      @id @default(uuid())

  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])

  productId     String
  product       Product     @relation(fields: [productId], references: [id])

  onHand        Decimal     @default(0) @db.Decimal(12,2)
  reserved      Decimal     @default(0) @db.Decimal(12,2)
  reorderLevel  Decimal     @default(0) @db.Decimal(12,2)

  active        Boolean     @default(true)

  ledgerEntries InventoryLedgerEntry[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([tenantId])
  @@index([productId])
  @@unique([tenantId, productId])
}

model InventoryLedgerEntry {
  id             String                 @id @default(uuid())

  tenantId       String
  tenant         Tenant                 @relation(fields: [tenantId], references: [id])

  stockId        String
  stock          InventoryStock         @relation(fields: [stockId], references: [id])

  productId      String
  product        Product                @relation(fields: [productId], references: [id])

  movementType   InventoryMovementType
  quantity       Decimal                @db.Decimal(12,2)

  referenceType  InventoryReferenceType @default(MANUAL)
  referenceId    String?

  note           String?

  createdById    String?

  createdAt      DateTime               @default(now())

  @@index([tenantId])
  @@index([productId])
  @@index([stockId])
  @@index([tenantId, createdAt])
}

// ===== PHASE 3: COMPATIBILITY & SOLUTIONS =====

enum CompatibilityRelationType {
  REQUIRED_WITH
  RECOMMENDED_WITH
  ALTERNATIVE_TO
  INCOMPATIBLE_WITH
}

enum RequirementType {
  REQUIRED
  RECOMMENDED
  OPTIONAL
}

model ProductCompatibility {
  id                    String                    @id @default(uuid())
  tenantId              String?                   // NULL = platform standard
  sourceProductId       String
  targetProductId       String
  relationType          CompatibilityRelationType
  reason                String?
  priority              Int                       @default(2) // 1=critical, 2=important, 3=nice-to-have
  active                Boolean                   @default(true)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  source                Product                   @relation("sourceCompatibility", fields: [sourceProductId], references: [id], onDelete: Cascade)
  target                Product                   @relation("targetCompatibility", fields: [targetProductId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sourceProductId, targetProductId, relationType])
  @@index([sourceProductId])
  @@index([targetProductId])
}

model SolutionTemplate {
  id                    String                    @id @default(uuid())
  tenantId              String?                   // NULL = platform standard
  code                  String
  name                  String
  categoryId            String?
  purpose               String?
  description           String?
  active                Boolean                   @default(true)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  items                 SolutionTemplateItem[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model SolutionTemplateItem {
  id                    String                    @id @default(uuid())
  solutionTemplateId    String
  productCategoryId     String?
  productId             String?
  requirementType       RequirementType
  defaultQuantity       Decimal                   @default(1) @db.Decimal(12,2)
  reason                String?
  priority              Int                       @default(2)
  createdAt             DateTime                  @default(now())

  template              SolutionTemplate          @relation(fields: [solutionTemplateId], references: [id], onDelete: Cascade)

  @@index([solutionTemplateId])
  @@index([productId])
}

// ===== PHASE 4: DECISION AUDIT TRAIL =====

enum DecisionRuleStatus {
  DRAFT
  ACTIVE
  DEPRECATED
  ARCHIVED
}

enum RecommendationRunStatus {
  PENDING
  MATCHED
  NO_MATCH
  ERROR
}

enum RecommendationAction {
  ACCEPTED
  REJECTED
  PARTIALLY_ACCEPTED
  IGNORED
}

model DecisionRule {
  id                    String              @id @default(uuid())
  tenantId              String?             // NULL = platform standard rule, value = shop-specific override

  code                  String              // e.g. "BOREWELL_3HP_SINGLE_PHASE"
  name                  String
  description           String?

  status                DecisionRuleStatus  @default(DRAFT)
  version               Int                 @default(1)

  // Matching conditions (stored as JSON for flexibility)
  conditions            Json                // e.g. { "depth": { "min": 300, "max": 350 }, "phase": "SINGLE" }

  // What to recommend when matched
  solutionTemplateId    String?             // Points to a SolutionTemplate to expand
  overrideProducts      Json?               // Optional product overrides on top of template

  priority              Int                 @default(10) // Lower = higher priority when multiple rules match
  active                Boolean             @default(true)

  approvedById          String?             // Who approved this rule
  approvedAt            DateTime?

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  runs                  RecommendationRun[]

  @@unique([tenantId, code, version])
  @@index([tenantId])
  @@index([status])
  @@index([active])
}

model RecommendationRun {
  id                    String                    @id @default(uuid())
  tenantId              String                    // Mandatory: every recommendation belongs to one shop
  tenant                Tenant                    @relation(fields: [tenantId], references: [id])

  // Who triggered this recommendation
  userId                String?
  user                  User?                     @relation(fields: [userId], references: [id])

  customerId            String?
  customer              Customer?                 @relation(fields: [customerId], references: [id])

  copilotSessionId      String?
  copilotSession        CopilotSession?           @relation(fields: [copilotSessionId], references: [id])

  // Which rule fired (null if no match)
  decisionRuleId        String?
  decisionRule          DecisionRule?             @relation(fields: [decisionRuleId], references: [id])

  status                RecommendationRunStatus   @default(PENDING)

  // The raw query inputs
  queryInputs           Json                      // e.g. { "depth": 325, "phase": "SINGLE", "budget": 15000 }

  // Summary of result
  totalCandidates       Int                       @default(0)
  topScore              Decimal?                  @db.Decimal(5,2)

  // For debugging failed runs
  errorMessage          String?

  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  candidates            RecommendationCandidate[]
  feedback              RecommendationFeedback?

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([userId])
  @@index([customerId])
  @@index([copilotSessionId])
  @@index([decisionRuleId])
}

model RecommendationCandidate {
  id                    String              @id @default(uuid())

  runId                 String
  run                   RecommendationRun   @relation(fields: [runId], references: [id], onDelete: Cascade)

  productId             String
  product               Product             @relation(fields: [productId], references: [id])

  rank                  Int                 // 1 = top recommendation

  totalScore            Decimal             @db.Decimal(5,2)

  // Deterministic score breakdown (stock + price + attributes + preference = total)
  scoreStock            Decimal             @db.Decimal(5,2)
  scorePriceMatch       Decimal             @db.Decimal(5,2)
  scoreAttributeMatch   Decimal             @db.Decimal(5,2)
  scorePreference       Decimal             @db.Decimal(5,2)

  // Why this product was selected or deselected
  selectedReason        String?             // For debugging: why this rank was assigned

  createdAt             DateTime            @default(now())

  @@unique([runId, productId])
  @@index([runId])
  @@index([productId])
  @@index([runId, rank])
}

model RecommendationFeedback {
  id                    String                  @id @default(uuid())

  runId                 String                  @unique
  run                   RecommendationRun       @relation(fields: [runId], references: [id], onDelete: Cascade)

  action                RecommendationAction

  // Which products were accepted/rejected
  acceptedProductIds    Json                    @default("[]")
  rejectedProductIds    Json                    @default("[]")

  // Free-text from shop owner
  notes                 String?

  // Who gave feedback
  userId                String?
  user                  User?                   @relation(fields: [userId], references: [id])

  createdAt             DateTime                @default(now())

  @@index([runId])
  @@index([userId])
}