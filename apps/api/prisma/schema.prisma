generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id           String        @id @default(uuid())

  name         String
  code         String        @unique

  businessType BusinessType  @default(GENERAL)

  email        String?
  phone        String?

  active       Boolean       @default(true)
  status       TenantStatus  @default(PENDING)

  rejectedReason String?

  approvedById   String?
  approvedAt     DateTime?

  users        User[]
  categories   ProductCategory[]
  products     Product[]
  inventoryStocks InventoryStock[]
  inventoryLedgerEntries InventoryLedgerEntry[]
  customers    Customer[]
  agents       Agent[]
  quotes       Quote[]
  whatsappConversations WhatsAppConversation[]
  subscription  Subscription?
  featureOverrides TenantFeatureOverride[]
  usageCounters UsageCounter[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum CommissionType {
  PERCENTAGE
}

model PlatformAdmin {
  id        String            @id @default(uuid())

  name      String
  email     String            @unique
  password  String

  role      PlatformAdminRole @default(SUPPORT_ADMIN)

  active    Boolean           @default(true)

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}
model Plan {
  id                String          @id @default(uuid())
  code              String          @unique
  name              String
  description       String?
  isActive          Boolean         @default(true)
  
  billingCycle      BillingCycle    @default(MONTHLY)
  priceAmount       Decimal         @db.Decimal(10,2)
  currency          String          @default("USD")
  trialDays         Int             @default(0)
  
  features          PlanFeature[]
  subscriptions     Subscription[]
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  
  @@index([isActive])
}

model FeatureFlag {
  id                String          @id @default(uuid())
  code              String          @unique
  name              String
  description       String?
  isActive          Boolean         @default(true)
  
  planFeatures      PlanFeature[]
  overrides         TenantFeatureOverride[]
  usageCounters     UsageCounter[]
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model PlanFeature {
  id                String          @id @default(uuid())
  
  planId            String
  plan              Plan            @relation(fields: [planId], references: [id])
  
  featureFlagId     String
  featureFlag       FeatureFlag     @relation(fields: [featureFlagId], references: [id])
  
  enabled           Boolean         @default(true)
  limitValue        Int?
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  
  @@unique([planId, featureFlagId])
  @@index([planId])
  @@index([featureFlagId])
}

model Subscription {
  id                String          @id @default(uuid())
  
  tenantId          String          @unique
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  
  planId            String
  plan              Plan            @relation(fields: [planId], references: [id])
  
  status            SubscriptionStatus @default(ACTIVE)
  startAt           DateTime
  endAt             DateTime?
  trialEndAt        DateTime?
  cancelAtPeriodEnd Boolean         @default(false)
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  
  @@index([tenantId])
  @@index([planId])
  @@index([status])
}

model TenantFeatureOverride {
  id                String          @id @default(uuid())
  
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  
  featureFlagId     String
  featureFlag       FeatureFlag     @relation(fields: [featureFlagId], references: [id])
  
  enabled           Boolean
  limitValue        Int?
  reason            String?
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  
  @@unique([tenantId, featureFlagId])
  @@index([tenantId])
  @@index([featureFlagId])
}

model UsageCounter {
  id                String          @id @default(uuid())
  
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  
  featureFlagId     String
  featureFlag       FeatureFlag     @relation(fields: [featureFlagId], references: [id])
  
  periodKey         String
  usedCount         Int             @default(0)
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  
  @@unique([tenantId, featureFlagId, periodKey])
  @@index([tenantId])
  @@index([periodKey])
}
model User {
  id        String   @id @default(uuid())

  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  name      String
  email     String

  password  String

  role      UserRole

  active    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@unique([tenantId, email])
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  SALES
  TECHNICIAN
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum PlatformAdminRole {
  SUPER_ADMIN
  SUPPORT_ADMIN
}

enum BusinessType {
  ELECTRICAL
  PLUMBING
  MOTOR
  GENERAL
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

model ProductCategory {
  id          String   @id @default(uuid())

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  name        String
  description String?

  active      Boolean  @default(true)

  products    Product[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@unique([tenantId, name])
}

model Product {
  id            String   @id @default(uuid())

  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])

  categoryId    String
  category      ProductCategory @relation(fields: [categoryId], references: [id])

  name          String

  sku           String?

  brand         String?

  unit          String   @default("NOS")

  costPrice     Decimal  @db.Decimal(12,2)
  sellingPrice  Decimal  @db.Decimal(12,2)

  imageUrl      String?

  active        Boolean  @default(true)

  quoteItems    QuoteItem[]
  inventoryStocks InventoryStock[]
  inventoryLedgerEntries InventoryLedgerEntry[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([categoryId])
}

model Customer {
  id              String   @id @default(uuid())

  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  name            String

  phone           String?
  whatsappNumber  String?
  email           String?

  address         String?

  gstNumber       String?

  active          Boolean  @default(true)

  quotes          Quote[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([name])
}

model Agent {
  id                          String          @id @default(uuid())

  tenantId                    String
  tenant                      Tenant          @relation(fields: [tenantId], references: [id])

  name                        String
  phone                       String?
  whatsappNumber              String?
  email                       String?
  address                     String?
  referenceCode               String?

  defaultCommissionType       CommissionType  @default(PERCENTAGE)
  defaultCommissionPercentage Decimal         @default(0) @db.Decimal(5,2)

  active                      Boolean         @default(true)

  quotes                      Quote[]

  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt

  @@index([tenantId])
  @@index([name])
  @@unique([tenantId, referenceCode])
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  INVOICED
  DISPATCHED
  REJECTED
  EXPIRED
  CANCELLED
}

enum InventoryMovementType {
  IN
  OUT
  ADJUST_IN
  ADJUST_OUT
  RESERVE
  RELEASE
  DISPATCH
}

enum InventoryReferenceType {
  MANUAL
  QUOTE
  ORDER
  RETURN
}

enum WhatsAppIntent {
  NONE
  ADD_CUSTOMER
  ADD_CATEGORY
  ADD_PRODUCT
  CREATE_QUOTE
}

model WhatsAppConversation {
  id            String          @id @default(uuid())

  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id])

  senderPhone   String

  lastIntent    WhatsAppIntent  @default(NONE)

  state         Json?

  lastMessage   String?
  lastResponse  String?

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([tenantId, senderPhone])
  @@unique([tenantId, senderPhone])
}

model Quote {
  id            String       @id @default(uuid())

  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])

  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id])

  agentId       String?
  agent         Agent?       @relation(fields: [agentId], references: [id])

  quoteNumber   String

  status        QuoteStatus  @default(DRAFT)
  stockReserved Boolean      @default(false)

  subtotal        Decimal       @db.Decimal(12,2)
  taxAmount       Decimal       @db.Decimal(12,2)
  totalAmount     Decimal       @db.Decimal(12,2)
  validUntil      DateTime?
  discountAmount  Decimal       @default(0) @db.Decimal(12,2)
  taxPercentage   Decimal       @default(0) @db.Decimal(5,2)

  agentCommissionType        CommissionType @default(PERCENTAGE)
  agentCommissionPercentage  Decimal        @default(0) @db.Decimal(5,2)
  agentCommissionAmount      Decimal        @default(0) @db.Decimal(12,2)

  notes         String?

  items         QuoteItem[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([tenantId])
  @@index([customerId])
  @@index([agentId])

  @@unique([tenantId, quoteNumber])
}

model QuoteItem {
  id            String      @id @default(uuid())

  quoteId       String
  quote         Quote       @relation(fields: [quoteId], references: [id])

  productId     String
  product       Product     @relation(fields: [productId], references: [id])

  productName   String

  quantity      Decimal     @db.Decimal(10,2)

  unitPrice     Decimal     @db.Decimal(12,2)

  lineTotal     Decimal     @db.Decimal(12,2)

  createdAt     DateTime    @default(now())

  @@index([quoteId])
}

model InventoryStock {
  id            String      @id @default(uuid())

  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])

  productId     String
  product       Product     @relation(fields: [productId], references: [id])

  onHand        Decimal     @default(0) @db.Decimal(12,2)
  reserved      Decimal     @default(0) @db.Decimal(12,2)
  reorderLevel  Decimal     @default(0) @db.Decimal(12,2)

  active        Boolean     @default(true)

  ledgerEntries InventoryLedgerEntry[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([tenantId])
  @@index([productId])
  @@unique([tenantId, productId])
}

model InventoryLedgerEntry {
  id             String                 @id @default(uuid())

  tenantId       String
  tenant         Tenant                 @relation(fields: [tenantId], references: [id])

  stockId        String
  stock          InventoryStock         @relation(fields: [stockId], references: [id])

  productId      String
  product        Product                @relation(fields: [productId], references: [id])

  movementType   InventoryMovementType
  quantity       Decimal                @db.Decimal(12,2)

  referenceType  InventoryReferenceType @default(MANUAL)
  referenceId    String?

  note           String?

  createdById    String?

  createdAt      DateTime               @default(now())

  @@index([tenantId])
  @@index([productId])
  @@index([stockId])
  @@index([tenantId, createdAt])
}